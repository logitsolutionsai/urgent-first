{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/logitsolutionsai/urgent-first/schema/evidence-graph.v1.schema.json",
  "title": "urgent-first evidence graph, schema version 1",
  "description": "evidence-graph.json written by `urgent-first snapshot` and printed by `links --json`. docs/EVIDENCE-GRAPH.md explains every field. No node or edge carries a tier or a priority.",
  "type": "object",
  "required": ["schemaVersion", "kind", "engineVersion", "snapshotId", "algorithms", "thresholds", "nodes", "edges", "clusters", "suppressedCandidates", "unresolvedReferences", "stats", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "urgent-first-evidence-graph" },
    "snapshotId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "thresholds": { "type": "object", "required": ["possible_duplicate", "same_symptom"] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": { "id": { "type": "string" }, "type": { "enum": ["issue", "pull_request", "item", "evidence", "release"] } },
        "not": { "anyOf": [{ "required": ["tier"] }, { "required": ["effectiveTier"] }, { "required": ["priority"] }] }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type", "certainty", "algorithm"],
        "properties": {
          "id": { "type": "string", "pattern": "^edge-[0-9a-f]{16}$" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["contains_evidence", "fixes", "references", "reported_after_release", "possible_duplicate", "same_symptom"] },
          "certainty": { "enum": ["direct", "candidate"] },
          "algorithm": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "quotes": { "type": "array", "items": { "type": "object", "required": ["field", "start", "end", "text"] } },
          "reasons": { "type": "array" },
          "metadata": { "type": "object" }
        },
        "not": { "anyOf": [{ "required": ["tier"] }, { "required": ["priority"] }] }
      }
    },
    "clusters": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "anchor", "members"], "properties": { "members": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "edge", "type", "score"] } } } }
    },
    "suppressedCandidates": { "type": "array", "items": { "type": "object", "required": ["id", "from", "to", "reason", "conflicts"], "properties": { "reason": { "const": "conflicting_evidence" } } } },
    "unresolvedReferences": { "type": "array" },
    "stats": { "type": "object", "required": ["items", "comparisons", "status"] },
    "warnings": { "type": "array" }
  }
}
