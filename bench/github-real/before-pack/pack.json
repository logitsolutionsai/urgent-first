    {
      "id": "PR-FIXES-URGENT",
      "tier": "T2",
      "category": "pr_fix_for_t1",
      "title": "Pull request that fixes an urgent problem",
      "why": "A pull request that fixes a security, data-loss, build or install problem should be reviewed soon so the fix can ship.",
      "source": {
        "citation": "This pack's maintainer policy (github-maintainer README, Rules section)",
        "url": "https://github.com/logitsolutionsai/urgent-first/tree/main/packs/github-maintainer#rules"
      },
      "match": {
        "all": [
          {
            "field": "metadata.type",
            "equals": "pull_request"
          },
          {
            "regex": "\\b(?:fix(?:es|ed)?|close[sd]?|resolve[sd]?)\\s+#\\d+"
          },
