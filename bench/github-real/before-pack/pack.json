    {
      "id": "REGRESSION-LATEST",
      "tier": "T1",
      "category": "regression_latest_release",
      "title": "Regression in the latest release with no workaround",
      "why": "Something that worked in the previous release and is broken in the latest one, with no workaround, hits everyone who upgrades. Minor and patch releases are meant to stay backward compatible.",
      "source": {
        "citation": "Semantic Versioning 2.0.0",
        "url": "https://semver.org/spec/v2.0.0.html"
      },
      "match": {
        "all": [
          {
            "mentions": "metadata.latest_release_aliases"
          },
          {
            "any": [
              {
                "terms": [
                  "after updating",
                  "after upgrading",
                  "after update",
                  "after the update",
                  "after the upgrade",
                  "since update",
                  "since updating",
                  "since upgrading",
                  "since the update",
                  "since the upgrade",
                  "after installing",
                  "upgraded from",
                  "updated to",
                  "update to",
                  "regression",
                  "used to work",
                  "worked on",
                  "worked in",
                  "worked fine",
                  "was fine",
                  "were fine",
                  "no problem with",
                  "works fine on",
                  "worked before",
                  "stopped working",
                  "no longer works",
                  "no longer work",
                  "broke",
                  "broken since"
                ],
                "except": [
                  "regression test",
                  "regression tests",
                  "regression testing",
                  "regression coverage",
                  "regression case",
                  "regression cases",
                  "regression suite"
                ]
              },
              {
                "regex": "\\bsince\\s+(?:version\\s+|v)?\\d+(?:\\.\\d+)+\\b"
              },
              {
                "regex": "\\bsince\\s+(?:(?:the|it|i|we|my|our|this|last|latest|recent)\\s+){0,3}(?:auto-?)?(?:updat|upgrad)\\w*"
              }
            ]
          },
          {
            "terms": [
              "every",
              "all",
              "nothing works",
              "unusable",
              "cannot",
              "can not",
              "unable",
              "fails",
              "failed",
              "error",
