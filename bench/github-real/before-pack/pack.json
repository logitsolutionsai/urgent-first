    {
      "id": "DATA-LOSS",
      "tier": "T1",
      "category": "data_loss",
      "title": "Data lost, overwritten or corrupted",
      "why": "Users losing work they cannot get back is the most expensive kind of bug; every hour it stays open it can hit more people.",
      "source": {
        "citation": "This pack's maintainer policy (github-maintainer README, Rules section)",
        "url": "https://github.com/logitsolutionsai/urgent-first/tree/main/packs/github-maintainer#rules"
      },
      "match": {
        "all": [
          {
            "any": [
              {
                "terms": [
                  "data loss",
                  "lost data",
                  "lost all",
                  "lost my",
                  "lost everything",
                  "not on disk",
                  "cannot recover",
                  "unrecoverable",
                  "irrecoverable",
                  "can not recover",
