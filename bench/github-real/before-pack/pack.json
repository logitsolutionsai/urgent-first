{
  "$schema": "../../../schema/pack.schema.json",
  "name": "github-maintainer-before",
  "version": "0.1.0",
  "title": "GitHub maintainer (before masking and pull request inheritance)",
  "description": "A frozen copy of the github-maintainer rules as they were before template masking and pull request inheritance, kept only so bench/github-real can report before and after. Do not use it for triage.",
  "mode": "standard",
  "item_noun": "issue",
  "tiers": [
    {
      "id": "T1",
      "name": "Discuss now",
      "description": "Look at this before anything else today."
    },
    {
      "id": "T2",
      "name": "Today",
      "description": "Real harm or a broken workflow for some users; handle soon."
    },
    {
      "id": "T3",
      "name": "In order",
      "description": "Baseline. Shown under 'No rule matched' in the original order."
    }
  ],
  "floor": {
    "labels": [
      {
        "match": "security",
        "tier": "T1"
      },
      {
        "match": "p0",
        "tier": "T1"
      },
      {
        "match": "critical",
        "tier": "T1"
      },
      {
        "match": "sev1",
        "tier": "T1"
      },
      {
        "match": "sev-1",
        "tier": "T1"
      },
      {
        "match": "data-loss",
        "tier": "T1"
      },
      {
        "match": "data loss",
        "tier": "T1"
      },
      {
        "match": "p1",
        "tier": "T2"
      },
      {
        "match": "regression",
        "tier": "T2"
      },
      {
        "match": "high-priority",
        "tier": "T2"
      },
      {
        "match": "priority: high",
        "tier": "T2"
      }
    ],
    "missing_priority": "baseline"
  },
  "matching": {
    "typos": true,
    "typo_min_length": 8,
    "window": 6
  },
  "context": {
    "negation_pre": [
      "no more",
      "without any"
    ],
    "negation_post": [
      "is fine",
      "are fine",
      "works fine",
      "was not lost",
      "were not lost",
      "not lost"
    ],
    "pseudo": [
      "no response",
      "no output",
      "no error",
      "no errors",
      "nothing happens",
      "does nothing",
      "do nothing",
      "not on disk",
      "nothing works"
    ]
  },
  "abbreviations": {
    "RCE": "remote code execution",
    "XSS": "cross site scripting",
    "SSRF": "server side request forgery",
    "CSRF": "cross site request forgery",
    "SQLi": "sql injection",
    "LPE": "local privilege escalation",
    "OOM": "out of memory",
    "segv": "segfault",
    "SIGSEGV": "segfault",
    "seg fault": "segfault",
    "segmentation fault": "segfault",
    "repro": "reproduce",
    "pls": "please",
    "plz": "please",
    "w/": "with"
  },
  "rules": [
