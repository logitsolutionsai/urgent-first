                  "wipes",
                  "erased",
                  "overwrote",
                  "overwritten",
                  "overwrites",
                  "corrupted",
                  "corrupts",
                  "corruption",
                  "data corruption",
                  "truncated",
                  "zero-length",
                  "zero length",
                  "0 bytes",
                  "emptied",
                  "deleted all",
                  "deletes all",
                  "deleted my"
                ],
                "except": [
                  "0 bytes on the release",
                  "lost connection",
                  "lost focus",
                  "lost the connection"
                ]
              },
              {
                "near": [
                  [
                    "lost",
                    "lose",
                    "losing",
                    "deleted",
                    "deletes",
                    "removed",
                    "wiped",
                    "erased",
                    "gone",
